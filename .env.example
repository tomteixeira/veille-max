# Copy to `.env`, or generate it from the running local stack with `npm run supabase:env`.

# Supabase project URL (local: http://127.0.0.1:56321).
NUXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (`sb_publishable_…`), safe to expose to the browser.
NUXT_PUBLIC_SUPABASE_KEY=
# Supabase secret key (`sb_secret_…`), server only. Never expose it to the browser.
NUXT_SUPABASE_SECRET_KEY=
# Shared secret of the tick endpoint (POST /api/cron/tick), server only. The same value
# goes into the hosted project's Vault as `tick_secret` (README, "Deploy"). Optional locally.
NUXT_TICK_SECRET=
